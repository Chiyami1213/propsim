  "governing_equations": [
    {
      "name": "head-pressure",
      "form": "\\Delta p = \\rho g H",
      "source_id": "HH-SP125",
      "location": "eq. (6-3) p.189 (SI)"
    },
    {
      "name": "head coefficient",
      "form": "\\psi = g H/U^2",
      "source_id": "HH-SP125",
      "location": "eq. (6-4) p.189 (SI)"
    },
    {
      "name": "specific speed",
      "form": "\\Omega_s = \\omega\\sqrt{Q}/(gH)^{3/4}",
      "source_id": "HH-SP125",
      "location": "eq. (6-7) p.190, SI dimensionless form",
      "note": "Ns_US = 2733 Omega_s"
    },
    {
      "name": "NPSH available",
      "form": "NPSH_a = \\frac{p_{in}-p_v}{\\rho g}",
      "source_id": "HH-SP125",
      "location": "eq. (6-8) p.192 (SI, no elevation term)"
    },
    {
      "name": "cavitation margin",
      "form": "NPSH_a > NPSH_c",
      "source_id": "HH-SP125",
      "location": "eq. (6-9) p.192"
    },
    {
      "name": "power",
      "form": "P = \\frac{\\dot m g H}{\\eta_p}",
      "source_id": "HH-SP125",
      "location": "eqs. (6-12), (6-13) p.194 (SI)"
    },
    {
      "name": "affinity (off-design)",
      "form": "Q\\propto\\omega,\\ H\\propto\\omega^2,\\ P\\propto\\omega^3",
      "source_id": "PROPSIM-CODE",
      "location": "propsim/core/feed/cycles.py (Pump)",
      "note": "standard similarity laws; H&H Fig. 6-24 shows the H-Q curve shape"
    }
  ],
  "valid_range": "Near the design flow coefficient; head breakdown under cavitation is not modelled.",
  "known_limitations": [
    "No inducer head-breakdown law yet (Stenning GTL-44 in the literature archive; block B follow-up).",
    "Bearing and seal losses lumped in efficiency."
  ],
  "implementation": "propsim/core/feed/cycles.py"
