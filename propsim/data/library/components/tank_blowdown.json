  "governing_equations": [
    {
      "name": "polytropic ullage",
      "form": "p_u V_{ull}^{n} = p_0 V_{ull,0}^{n}",
      "source_id": "HH-SP125",
      "location": "eq. (5-15) p.159 (polytropic gas expansion)"
    },
    {
      "name": "ullage growth",
      "form": "\\dot V_{ull} = \\dot m_{out}/\\rho_l",
      "source_id": "PROPSIM-CODE",
      "location": "propsim/core/feed/network.py: state dV"
    }
  ],
  "valid_range": "1 <= n <= cp/cv of the pressurant.",
  "known_limitations": [
    "Constant n over the burn; real blowdown drifts from isentropic toward isothermal as wall heat flows in.",
