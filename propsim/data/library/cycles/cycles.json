      "turbine_inlet_temperature_max": {
        "value": 1199.82,
        "unit": "K",
        "quality": "published",
        "source_id": "HH-SP125",
        "location": "p.197, text: practical design limit around 1700 degF",
        "formula": "1700 degF to K"
      },
      "governing_equations": [
        {
          "name": "turbopump cycle efficiency",
          "form": "\\eta_c = (I_s)_{eng} / (I_s)_{tc}",
          "source_id": "HH-SP125",
          "location": "eq. (6-21) p.199"
        },
        {
          "name": "separate-flow (open) cycle efficiency",
          "form": "\\eta_{sc} = \\frac{\\dot m_{tc}(I_s)_{tc} + \\dot m_t (I_s)_{te}}{\\dot m_{eng}(I_s)_{tc}}",
          "source_id": "HH-SP125",
          "location": "eq. (6-22) p.200"
        },
        {
          "name": "turbine power from available energy",
          "form": "P_t = \\eta_t \\dot m_t c_p T_0 \\left[1 - (p_e/p_0)^{(\\gamma-1)/\\gamma}\\right]",
          "source_id": "HH-SP125",
          "location": "eqs. (6-17) to (6-19) pp.196-198"
        },
        {
          "name": "pump power",
          "form": "P_p = \\dot m g_0 H / \\eta_p",
          "source_id": "HH-SP125",
          "location": "eqs. (6-3), (6-4) p.189"
        },
        {
          "name": "shaft power balance",
          "form": "\\sum P_t = \\sum P_p + P_{aux}",
          "source_id": "HH-SP125",
          "location": "Sample Calculation (6-5) p.199"
        }
      ],
      "known_limitations": [
        "Turbine exhaust produces little thrust (A-1: 2700 lb of 750000 lb), so engine Isp is below thrust-chamber Isp."
      ]
    },
