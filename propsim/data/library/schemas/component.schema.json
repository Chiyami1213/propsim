{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://propsim/library/schemas/component.schema.json",
  "title": "Component type",
  "description": "One component type of the engine graph: ports, parameters with sourced defaults, state variables, plot outputs and governing equations. SI units only.",
  "type": "object",
  "required": ["type", "category", "description", "ports", "parameters", "state_variables", "outputs_for_plots",
               "governing_equations", "valid_range", "known_limitations"],
  "additionalProperties": false,
  "properties": {
    "type": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "category": {"enum": ["tank", "valve", "line", "volume", "turbomachinery", "combustion", "nozzle", "heat_transfer", "control"]},
    "description": {"type": "string"},
    "ports": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "kind", "direction"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "kind": {"enum": ["fluid", "shaft", "thermal", "signal"]},
          "direction": {"enum": ["in", "out", "bidir"]},
          "medium": {"type": "string", "description": "liquid, gas, any (fluid ports); torque (shaft); heat (thermal); command (signal)"}
        }
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object", "required": ["name", "unit", "default", "meaning"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "unit": {"type": "string"},
          "default": {"$ref": "sourced_value.schema.json"},
          "min": {"type": ["number", "null"]},
          "max": {"type": ["number", "null"]},
          "user_input": {"type": "boolean", "description": "true for design choices (geometry, set points) that have no generic default"},
          "table": {"type": "string", "description": "library table that gives values for this parameter, e.g. components/tables/loss_coefficients.csv"},
          "meaning": {"type": "string"}
        }
      }
    },
    "state_variables": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "unit", "meaning"], "additionalProperties": false,
                "properties": {"name": {"type": "string"}, "unit": {"type": "string"}, "meaning": {"type": "string"}}}
    },
    "outputs_for_plots": {
      "type": "array",
      "items": {"type": "object", "required": ["name", "unit", "meaning"], "additionalProperties": false,
                "properties": {"name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}, "unit": {"type": "string"},
                               "meaning": {"type": "string"}}}
    },
    "governing_equations": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["name", "form", "source_id", "location"], "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "form": {"type": "string", "description": "Equation in SI as implemented, LaTeX"},
          "source_id": {"type": "string"},
          "location": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    },
    "valid_range": {"type": "string"},
    "known_limitations": {"type": "array", "items": {"type": "string"}},
    "implementation": {"type": "string", "description": "PropSim module that implements the equations today, if any"}
  }
}
